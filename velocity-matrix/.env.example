# Velocity Matrix secure bindings — copy to .env and fill values
#   cp .env.example .env
# Never commit .env. B0 exit: secrets resolve in Deno via Deno.env.get.

# Base44 CLI / deploy (required for `bun run deploy`)
BASE44_APP_ID=
BASE44_API_KEY=
BASE44_ACCESS_TOKEN=
BASE44_REFRESH_TOKEN=

# Frontend Vite (exposed to browser — app id only, never secrets)
# Keep in sync with BASE44_APP_ID for local SDK auth.
VITE_BASE44_APP_ID=

# Connector secrets (Document 06 / Deno.env.get)
GITHUB_PAT=
LLM_API_KEY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional: set VELOCITY_MATRIX_LIVE_RLS=1 to enable live RLS probe (B6)
# VELOCITY_MATRIX_LIVE_RLS=

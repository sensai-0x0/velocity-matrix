{
  "name": "GeneratedSolutions",
  "type": "object",
  "description": "AI resolution artifacts — ResolutionArtifact flattened for storage.",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user ID — RLS isolation key"
    },
    "blocker_reference": {
      "type": "string",
      "description": "ActiveBlockers record ID that triggered this artifact"
    },
    "solution_type": {
      "type": "string",
      "enum": ["code_snippet", "architecture_diagram", "terminal_command"],
      "description": "ResolutionArtifact.solution_type"
    },
    "language": {
      "type": "string",
      "description": "Syntax language e.g. typescript, json, bash"
    },
    "code": {
      "type": "string",
      "description": "Raw code / command payload"
    },
    "file_path": {
      "type": "string",
      "description": "Optional target path e.g. /src/components/Button.tsx"
    },
    "neural_summary": {
      "type": "string",
      "description": "Minimalist context text above the code block"
    },
    "available_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["deploy", "override", "discard", "merge"]
      },
      "default": ["deploy", "override", "discard"],
      "description": "UI actions — include merge when phantom merge_ready"
    },
    "has_been_committed": {
      "type": "boolean",
      "default": false,
      "description": "True after github_auto_commit succeeds (branch push for phantoms)"
    },
    "deployment_url": {
      "type": "string",
      "format": "uri",
      "description": "Commit or deploy URL from ExecutionResult"
    },
    "is_discarded": {
      "type": "boolean",
      "default": false,
      "description": "True after Resolution Feed Discard — hide from active UI (B5)"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["sync", "phantom"],
      "default": "sync",
      "description": "sync = Resolution Feed path; phantom = background thread"
    },
    "phantom_thread_id": {
      "type": "string",
      "description": "PhantomThreads id when execution_mode is phantom"
    },
    "git_branch": {
      "type": "string",
      "description": "Branch name for 1-click merge affordance"
    },
    "merge_ready": {
      "type": "boolean",
      "default": false,
      "description": "True when phantom branch is ready for explicit merge"
    },
    "merge_status": {
      "type": "string",
      "enum": ["pending", "ready", "merged", "abandoned"],
      "description": "Phantom merge lifecycle"
    },
    "eval_status": {
      "type": "string",
      "enum": ["not_run", "passing", "failing"],
      "default": "not_run",
      "description": "Post-generation eval result for tactile telemetry"
    },
    "telemetry_event": {
      "type": "string",
      "description": "Last MatrixTelemetryEvent type for audio bridge"
    }
  },
  "required": [
    "owner_id",
    "blocker_reference",
    "solution_type",
    "language",
    "code",
    "neural_summary",
    "available_actions",
    "has_been_committed"
  ],
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": { "data.owner_id": "{{user.id}}" },
    "update": { "data.owner_id": "{{user.id}}" },
    "delete": { "data.owner_id": "{{user.id}}" }
  }
}

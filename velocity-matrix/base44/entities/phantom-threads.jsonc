{
  "name": "PhantomThreads",
  "type": "object",
  "description": "Background multi-step Phantom Thread workers (Phase 2.0).",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user ID — RLS isolation key"
    },
    "session_id": {
      "type": "string",
      "description": "Hackathon session this phantom belongs to"
    },
    "parent_blocker_id": {
      "type": "string",
      "description": "ActiveBlockers ID that spawned this thread"
    },
    "brief": {
      "type": "string",
      "description": "Multi-step task description from the hacker"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "compiling", "pushing", "complete", "failed"],
      "default": "queued",
      "description": "Worker lifecycle status for UI pulse"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["id", "label", "status"]
      },
      "default": [],
      "description": "Ordered step progress for the micro-panel"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "description": "Aggregate thread progress 0–100"
    },
    "git_branch": {
      "type": "string",
      "description": "Feature branch pushed on success e.g. phantom/<id>-slug"
    },
    "error_trace": {
      "type": "string",
      "description": "Failure detail when status is failed"
    },
    "telemetry_event": {
      "type": "string",
      "description": "Last MatrixTelemetryEvent type for audio bridge"
    },
    "started_at": {
      "type": "number",
      "description": "Unix ms when the thread started"
    },
    "finished_at": {
      "type": "number",
      "description": "Unix ms when the thread finished"
    }
  },
  "required": [
    "owner_id",
    "session_id",
    "parent_blocker_id",
    "brief",
    "status",
    "completion_percentage",
    "started_at"
  ],
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": { "data.owner_id": "{{user.id}}" },
    "update": { "data.owner_id": "{{user.id}}" },
    "delete": { "data.owner_id": "{{user.id}}" }
  }
}
